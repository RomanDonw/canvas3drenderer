<panel size="400,400" color="#00000080" scrollable="true" max-length="400">
    <label autoresize="true" text-align="center">Model X offset:</label>
    <textbox id="slidemdlx" validator="validnum" consumer="function(v) globvars.model.x = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Model Y offset:</label>
    <textbox id="slidemdly" validator="validnum" consumer="function(v) globvars.model.y = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Model Z offset:</label>
    <textbox id="slidemdlz" validator="validnum" consumer="function(v) globvars.model.z = tonumber(v) end"></textbox>

    <label id="mdlrxtext" autoresize="true" text-align="center"></label>
    <trackbar id="slidemdlrx" min="0" max="360" step="0.001" value="0" consumer="updmdlrx"></trackbar>

    <label id="mdlrytext" autoresize="true" text-align="center"></label>
    <trackbar id="slidemdlry" min="0" max="360" step="0.001" value="0" consumer="updmdlry"></trackbar>

    <label id="mdlrztext" autoresize="true" text-align="center"></label>
    <trackbar id="slidemdlrz" min="0" max="360" step="0.001" value="0" consumer="updmdlrz"></trackbar>

    <label autoresize="true" text-align="center">Model X scale:</label>
    <textbox id="slidemdlsx" validator="validonlyposnum" consumer="function(v) globvars.model.sx = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Model Y scale:</label>
    <textbox id="slidemdlsy" validator="validonlyposnum" consumer="function(v) globvars.model.sy = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Model Z scale:</label>
    <textbox id="slidemdlsz" validator="validonlyposnum" consumer="function(v) globvars.model.sz = tonumber(v) end"></textbox>

    <!-- ======================================================================================================================== -->

    <label autoresize="true" text-align="center">Texture X offset:</label>
    <textbox id="slidetexx" validator="validnum" consumer="function(v) globvars.texture.x = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Texture Y offset:</label>
    <textbox id="slidetexy" validator="validnum" consumer="function(v) globvars.texture.y = tonumber(v) end"></textbox>

    <label id="texrxtext" autoresize="true" text-align="center"></label>
    <trackbar id="slidetexrx" min="0" max="360" step="0.001" value="0" consumer="updtexrx"></trackbar>

    <label id="texrytext" autoresize="true" text-align="center"></label>
    <trackbar id="slidetexry" min="0" max="360" step="0.001" value="0" consumer="updtexry"></trackbar>

    <label autoresize="true" text-align="center">Texture X scale:</label>
    <textbox id="slidetexsx" validator="validonlyposnum" consumer="function(v) globvars.texture.sx = tonumber(v) end"></textbox>

    <label autoresize="true" text-align="center">Texture Y scale:</label>
    <textbox id="slidetexsy" validator="validonlyposnum" consumer="function(v) globvars.texture.sy = tonumber(v) end"></textbox>
</panel>